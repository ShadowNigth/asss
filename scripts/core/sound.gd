extends Node
## Sound effects: a small pool of players plus 3D ones for world events.
##
## The WAVs are generated by `tools/audio/make_sounds.py`; if a file is missing
## the call is a silent no-op rather than an error, so the game still runs in a
## checkout where the audio has not been generated.

const DIR := "res://assets/audio"
## Weapons share a handful of synthesised shots; each weapon maps to the class
## that reads closest to its real report.
## Which synthesised shot each retail weapon reads closest to.
const SHOT_BY_WEAPON := {
	"glock": "shot_pistol", "usp": "shot_pistol", "deagle": "shot_pistol",
	"elite": "shot_pistol", "fiveseven": "shot_pistol",
	"mp5": "shot_smg", "tmphk": "shot_smg", "p90": "shot_smg",
	"ump45": "shot_smg", "mac10": "shot_smg",
	"ak47": "shot_rifle", "m4a1": "shot_rifle", "galil": "shot_rifle",
	"famas": "shot_rifle", "sg552": "shot_rifle", "aug": "shot_rifle",
	"awp": "shot_sniper", "scout": "shot_sniper",
	"g3sg1": "shot_sniper", "sg550": "shot_sniper",
	"m3": "shot_shotgun", "xm1014": "shot_shotgun",
	"m249": "shot_rifle",
}
const POOL_SIZE := 8

var _streams := {}
var _ui_players: Array[AudioStreamPlayer] = []
var _ui_cursor := 0
var _world_root: Node3D
var _step_index := 0
var _enabled := true


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	for name in ["shot_rifle", "shot_pistol", "shot_smg", "shot_sniper", "shot_shotgun",
			"knife", "reload", "step_0", "step_1", "step_2", "land", "impact", "flesh",
			"beep", "plant", "defuse", "explosion", "round_win", "round_lose", "switch"]:
		var path := "%s/%s.wav" % [DIR, name]
		if ResourceLoader.exists(path):
			_streams[name] = load(path)
	if _streams.is_empty():
		_enabled = false
		push_warning("no audio found; run tools/audio/make_sounds.py")
		return
	for _index in POOL_SIZE:
		var player := AudioStreamPlayer.new()
		player.bus = "Master"
		add_child(player)
		_ui_players.append(player)


func _attach_world(root: Node3D) -> void:
	_world_root = root


func has_sound(name: String) -> bool:
	return _streams.has(name)


func play(name: String, volume_db: float = 0.0, pitch: float = 1.0) -> void:
	## Non-positional playback (UI, own weapon, own footsteps).
	if not _enabled or not _streams.has(name):
		return
	var player := _ui_players[_ui_cursor]
	_ui_cursor = (_ui_cursor + 1) % _ui_players.size()
	player.stream = _streams[name]
	player.volume_db = volume_db
	player.pitch_scale = clampf(pitch, 0.35, 3.0)
	player.play()


func play_at(name: String, position: Vector3, volume_db: float = 0.0, pitch: float = 1.0,
		max_distance: float = 45.0) -> void:
	## Positional playback for anything happening in the world: gunshots from
	## bots, impacts, the C4 going off.  The player is attached to the scene so
	## Godot can compute distance attenuation against the listener.
	if not _enabled or not _streams.has(name) or _world_root == null:
		return
	var player := AudioStreamPlayer3D.new()
	player.stream = _streams[name]
	player.volume_db = volume_db
	player.pitch_scale = clampf(pitch, 0.35, 3.0)
	player.max_distance = max_distance
	player.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
	player.unit_size = 8.0
	_world_root.add_child(player)
	player.global_position = position
	player.finished.connect(player.queue_free)
	player.play()


func shot_sound(weapon_id: String) -> String:
	## Pick the synthesised shot that reads closest to a weapon's report.
	if weapon_id == "knife":
		return "knife"
	if SHOT_BY_WEAPON.has(weapon_id):
		return str(SHOT_BY_WEAPON[weapon_id])
	var slot := str(Weapons.get_weapon(weapon_id).get("slot", ""))
	if slot == "secondary":
		return "shot_pistol"
	if slot == "primary":
		return "shot_rifle"
	return ""


func play_shot(weapon_id: String, position: Vector3, positional: bool, volume_db: float = 0.0) -> void:
	var name := shot_sound(weapon_id)
	if name.is_empty():
		return
	var pitch := randf_range(0.94, 1.06)
	if positional:
		play_at(name, position, volume_db, pitch, 70.0)
	else:
		play(name, volume_db, pitch)


func footstep(position: Vector3, positional: bool) -> void:
	var name := "step_%d" % _step_index
	_step_index = (_step_index + 1) % 3
	if positional:
		play_at(name, position, -6.0, randf_range(0.9, 1.1), 18.0)
	else:
		play(name, -9.0, randf_range(0.9, 1.1))
