[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="weapon"
3d_physics/layer_4="gibs"
3d_physics/layer_5="triggers"

[physics]

3d/default_gravity=20.32
3d/default_linear_damp=0.0
3d/default_angular_damp=0.4
common/physics_ticks_per_second=64
common/max_physics_steps_per_frame=12
common/physics_jitter_fix=0.0
3d/solver/solver_iterations=24

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.13, 0.15, 0.18, 1)
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
