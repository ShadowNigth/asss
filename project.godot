; Engine configuration file.
; Counter-Strike 1.5 reimplementation for Godot 4.4.
;
; NOTE: the physics engine is deliberately left at the default (GodotPhysics3D).
; The 3d/physics_engine setting must not be forced to JoltPhysics3D: Jolt is
; not compiled into the reference build, and pinning it makes CharacterBody3D
; simulation abort inside the physics server on startup.

config_version=5

[application]

config/name="Counter-Strike 1.5 (Godot port)"
config/description="Source-accurate remake of the CS 1.5 maps, movement and gunplay."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.05, 0.05, 0.06, 1)

[autoload]

Cfg="*res://scripts/core/game_config.gd"
Weapons="*res://scripts/core/weapon_db.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="cs15"

[filesystem]

import/blender/enabled=false
import/fbx2gltf/enabled=false

[input]

